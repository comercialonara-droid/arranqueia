# ─────────────────────────────────────────────────────────────
# Arranque — IA de vendas no WhatsApp para lojas de veículos
# Copie para .env e preencha. Nunca suba o .env para o Git.
# ─────────────────────────────────────────────────────────────

# Servidor
PORT=3000
# Endereço público HTTPS do servidor (a Meta precisa alcançar o /webhook e baixar as fotos em /uploads)
PUBLIC_URL=https://ia.sualoja.com.br
DATA_DIR=./data
TZ_LOJA=America/Sao_Paulo

# Painel
ADMIN_PASSWORD=troque-por-uma-senha-forte
# Texto longo e aleatório (ex.: openssl rand -hex 32)
SESSION_SECRET=

# IA (Claude). Sem a chave, o sistema roda em modo de teste com respostas simuladas.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high  (medium = bom equilíbrio entre velocidade e qualidade para WhatsApp)
AI_EFFORT=medium
# Se o modelo recusar algo, a própria API tenta de novo com o modelo de reserva recomendado
AI_SERVER_FALLBACK=on

# WhatsApp Cloud API (Meta) — ver docs/configurar-meta.md
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=arranque-verify
GRAPH_VERSION=v25.0

# Conversões para os anúncios (Conversions API para mensagens)
META_DATASET_ID=
# Opcional: por padrão usa o WA_ACCESS_TOKEN (precisa da permissão whatsapp_business_manage_events)
META_CAPI_TOKEN=
# Opcional: código de teste do Gerenciador de Eventos, para ver os eventos chegando
META_TEST_EVENT_CODE=

# Transcrição de áudio (opcional). Sem ela, a IA pede para o cliente escrever.
OPENAI_API_KEY=

# Ritmo de resposta
# Espera depois da última mensagem do cliente antes de responder (ele costuma mandar várias seguidas)
DEBOUNCE_MS=6000
TYPING_DELAY_MS=1200
LOG_LEVEL=info
